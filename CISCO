# Prompt user for the target word and the search string
word = input("Enter the word to search for: ").lower()
text = input("Enter the string to search in: ").lower()

found = True
start_pos = 0

# Check each character of the target word in sequential order
for char in word:
    # find() with 2 arguments: find(character, start_index)
    pos = text.find(char, start_pos)
    if pos == -1:
        found = False
        break
    # Update search starting index to the position immediately after the match
    start_pos = pos + 1

if found:
    print("Yes")
else:
    print("No")

# 1. Read 9 rows of input from the user
board = []
for _ in range(9):
    row = input().strip()
    board.append(row)

def is_valid_sudoku(board):
    # Standard set of digits 1 through 9
    valid_set = set("123456789")

    # Check 1: Validate each row
    for row in board:
        if set(row) != valid_set or len(row) != 9:
            return False

    # Check 2: Validate each column
    for col in range(9):
        column_digits = set(board[row][col] for row in range(9))
        if column_digits != valid_set:
            return False

    # Check 3: Validate each 3x3 sub-square
    for row_start in (0, 3, 6):
        for col_start in (0, 3, 6):
            square_digits = set(
                board[r][c]
                for r in range(row_start, row_start + 3)
                for c in range(col_start, col_start + 3)
            )
            if square_digits != valid_set:
                return False

    return True

# 2. Check board and print output
if is_valid_sudoku(board):
    print("Yes")
else:
    print("No")

def read_int(prompt, min, max):
    while True:
        try:
            value = int(input(prompt))
            if min <= value <= max:
                return value
            else:
                print(f"Error: the value is not within permitted range ({min}..{max})")
        except ValueError:
            print("Error: wrong input")

v = read_int("Enter a number from -10 to 10: ", -10, 10)

print("The number is:", v)
